# syntax=docker/dockerfile:1.7

FROM node:22.20-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@6.0.8

FROM base AS build

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Keep the runtime image free of compilers and development-only packages.
# CI=true is load-bearing, not decoration: `pnpm prune` asks "The modules
# directories will be removed and reinstalled from scratch. Proceed? (Y/n)" and
# a docker build has no TTY to answer it, so without this the build hangs here
# forever rather than failing (observed: 6+ minutes, no output, killed by hand).
RUN CI=true pnpm prune --prod --ignore-scripts

FROM base AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    nginx \
 && rm -rf /var/lib/apt/lists/* \
 && addgroup --system www \
 && adduser --system --ingroup www --home /home/www --shell /usr/sbin/nologin www \
 && mkdir -p /home/www /tmp/nginx/client_body /tmp/nginx/proxy \
    /tmp/nginx/fastcgi /tmp/nginx/uwsgi /tmp/nginx/scgi /tmp/pm2 /uploads \
 && chown -R www:www /home/www /tmp/nginx /tmp/pm2 /uploads

ENV NODE_ENV=production
ENV HOME=/home/www
ENV PM2_HOME=/tmp/pm2

WORKDIR /app
COPY --from=build --chown=www:www /app /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

USER www

EXPOSE 5000
CMD ["sh", "-c", "nginx && exec pnpm run pm2"]
