# See http://help.github.com/ignore-files/ for more about ignoring files.

# ── Environment & secrets (never commit) ──
# This app holds OAuth access and refresh tokens for real social accounts.
# `.env.example` is the only environment file that belongs in git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
*credentials*.json
*secret*.json
firebase-secrets.json
*service-account*.json
*.tfvars
*.tfstate
*.tfstate.*
.terraform/

# ignore Secrets folder
.secrets/

# compiled output
dist
tmp
/out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*

# IDE - VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

# Next.js
.next
next-env.d.ts

# Node / build caches
.eslintcache
.vercel

# Vim files
**/*.swp
**/*.swo

# Temporary files
*.orig
*.~*~
*.tsbuildinfo

# Generated, not authored
libraries/plugins/src/plugins.ts
i18n.cache

# Generated by apps/frontend/scripts/fetch-gtm.mjs on install
apps/frontend/public/g.js

# NOTE: do NOT ignore .dockerignore; commit lockfiles (pnpm-lock.yaml).
